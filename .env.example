# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# MOSS Official SDK Credentials (https://docs.moss.dev)
# Configure project credentials from Moss portal (https://portal.moss.dev)
# When omitted, GuardMoss runs its embedded in-process sub-10ms Moss semantic engine.
MOSS_PROJECT_ID=""
MOSS_PROJECT_KEY=""
MOSS_MODEL_ID="moss-minilm"
MOSS_INDEX_NAME="guardmoss-security-policies"
MOSS_ALPHA="0.6"
MOSS_TIMEOUT_MS="250"


# LiveKit Voice Agent Credentials (optional for live voice streams)
LIVEKIT_URL="ws://localhost:7880"
LIVEKIT_API_KEY="devkey"
LIVEKIT_API_SECRET="secret"
DEEPGRAM_API_KEY=""

# LLM_GATEWAY_URL: Base URL for virtual LLM gateway (hidevs.xyz)
LLM_GATEWAY_URL="https://llm.hidevs.xyz"

# LLM_GATEWAY_API_KEY: Virtual API key for accessing gemini-3.5-flash-lite / gemini-3.5-flash / gemini-3.6-flash
LLM_GATEWAY_API_KEY=""

# LLM_GATEWAY_MODEL: Model to use for the AI Agent (e.g. gemini-3.5-flash-lite)
LLM_GATEWAY_MODEL="gemini-3.5-flash-lite"

